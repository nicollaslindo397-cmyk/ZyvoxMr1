    <!-- Barra de endereço -->
    <string name="url_hint">Endereço ou busca</string>
    <string name="url_open">Abrir</string>
    <string name="url_default">https://www.google.com</string>

    <!--
      Destinos dos botões do dock.

      `url_default` era `https://example.com`, um placeholder de desenvolvimento que virou a
      página que todo botão abria. Agora é o Google, que é o que "Janela" quer dizer na
      prática: uma página inicial com barra de endereço para ir a qualquer outro site.

      `m.youtube.com` em vez de `youtube.com`: o site desktop assume ponteiro e janela grande,
      e num WebView de ~0,6 m o layout móvel é o que presta. O Chrome fica no domínio comum
      porque ele mesmo redireciona e o usuário pode querer a versão desktop.
    -->
    <string name="url_youtube">https://m.youtube.com</string>
    <string name="url_chrome">https://www.google.com/chrome/</string>

    <!-- Acessibilidade -->
    <string name="cd_hand_cursor">Cursor da mão</string>
    <string name="cd_camera_preview">Passthrough da câmera traseira</string>
