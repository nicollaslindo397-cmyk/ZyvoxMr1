<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Zyvox MR</string>

    <!-- Permissão de câmera -->
    <string name="permission_camera_title">Câmera necessária</string>
    <string name="permission_camera_body">O Zyvox MR usa a câmera traseira como passthrough e para rastrear suas mãos. Nada é enviado para fora do aparelho.</string>
    <string name="permission_camera_grant">Permitir câmera</string>
    <string name="permission_camera_settings">Abrir configurações</string>
    <string name="permission_camera_denied">Sem acesso à câmera não há passthrough nem hand tracking.</string>

    <!-- Estado / avisos -->
    <string name="status_initializing">Iniciando câmera…</string>
    <string name="status_no_model">Modelo de hand tracking ausente — veja BUILD.md</string>
    <!--
      Diz ONDE pôr a mão, porque com câmera traseira isso não é óbvio e é o contrário do
      instinto: a mão que segura o aparelho fica do lado da tela, onde a câmera não vê.

      A versão anterior desta string dizia "entre ele e você", o que estava ERRADO e pior que
      não dizer nada: a câmera traseira aponta para LONGE de quem segura o aparelho, então uma
      mão entre o celular e o rosto fica atrás da câmera e nunca aparece. Estender o braço é o
      movimento certo.
    -->
    <string name="status_show_hands">Estenda o braço: a mão precisa estar ALÉM do aparelho, do lado oposto à tela</string>
    <string name="status_tracking">Rastreando %1$d mão(s)</string>

    <!--
      Controles de fallback do HUD. Todos existem também como gesto de mão; estão aqui porque
      um recurso que só funciona quando o rastreamento funciona não é testável.
    -->
    <string name="hud_background">Fundo</string>
    <string name="hud_dock_smaller">Dock −</string>
    <string name="hud_dock_bigger">Dock +</string>

    <!--
      Documenta os gestos globais. São invisíveis por natureza — nada na tela indica que
      existem — então sem esta linha o usuário nunca os descobriria.
    -->
    <string name="hud_gesture_hint">Mão direita: pinch no vazio = dock · mão fechada = fundo</string>

